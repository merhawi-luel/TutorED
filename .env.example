# ─── URLs ────────────────────────────────────────────────────
# Frontend URL (used by backend for CORS and redirects)
# Set in Render dashboard for backend
FRONTEND_URL=https://your-frontend.vercel.app

# Backend API URL (used by frontend to make API calls)
# Set in Vercel dashboard for frontend
# IMPORTANT: Don't set this locally - vite proxy handles it
VITE_API_URL=https://your-backend.onrender.com/api

# ─── Database (Supabase PostgreSQL) ───────────────────────────
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ─── Authentication ───────────────────────────────────────────
JWT_SECRET=your-secure-jwt-secret-here

# ─── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── File Storage ─────────────────────────────────────────────
FILE_STORAGE=supabase

# ─── Chapa Payment Gateway ────────────────────────────────────
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxx
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxx
CHAPA_ENCRYPTION_KEY=xxxxx
BACKEND_URL=http://localhost:3001
CHAPA_WEBHOOK_SECRET=xxxxx

# ─── Deployment Configuration ──────────────────────────────────
# 
# VERCEL (Frontend):
# 1. Go to your Vercel project settings
# 2. Navigate to Environment Variables
# 3. Add these variables:
#    - VITE_API_URL = https://your-backend.onrender.com/api
#
# RENDER (Backend):
# 1. Go to your Render service dashboard
# 2. Navigate to Environment
# 3. Add these variables:
#    - DATABASE_URL = (your Supabase connection string)
#    - JWT_SECRET = (your JWT secret)
#    - SUPABASE_URL = (your Supabase URL)
#    - SUPABASE_ANON_KEY = (your Supabase anon key)
#    - SUPABASE_SERVICE_ROLE_KEY = (your Supabase service role key)
#    - FRONTEND_URL = https://your-frontend.vercel.app
#    - FILE_STORAGE = supabase
#    - CHAPA_PUBLIC_KEY = (if using Chapa)
#    - CHAPA_SECRET_KEY = (if using Chapa)
#    - BACKEND_URL = https://your-backend.onrender.com
#
# IMPORTANT: 
# - Never commit .env file to git (it's in .gitignore)
# - VITE_ prefix is required for variables accessible in Vite frontend
# - Backend URL in Render should match what you set in Vercel
